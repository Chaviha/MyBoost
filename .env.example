# Postgres connection string (from Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Set to "true" if your Postgres provider requires SSL (Neon/Supabase/Railway usually do)
DATABASE_SSL=true

NODE_ENV=production

# Port the Express server listens on. Railway/Render set PORT automatically,
# but this app reads API_PORT specifically -- most platforms let you map that
# via their dashboard, or you can just leave this unset and rely on their default.
API_PORT=3001

# Name of the session cookie (optional, defaults to lifeboost_session)
SESSION_COOKIE_NAME=lifeboost_session

# Comma-separated list of emails that should get admin access
ADMIN_EMAILS=you@example.com

# Public URL of the deployed frontend (used in password-reset emails)
APP_URL=https://your-frontend.vercel.app

# --- Optional: outgoing email for password reset ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional: for local/dev testing without real email ---
LOG_RESET_LINKS=true
RETURN_RESET_LINK=false
